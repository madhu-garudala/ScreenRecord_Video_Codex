{
  "name": "onetake",
  "productName": "OneTake",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local desktop screen recorder",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "tsc -p tsconfig.electron.json && node --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron@44.5.0": true,
    "fsevents@2.3.3": true
  }
}
